<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#07110E">
<LinearLayout android:orientation="vertical" android:padding="22dp" android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SNAP COBRO" android:textStyle="bold" android:textSize="30sp" android:textColor="#52F2B2"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="MODO PRUEBA ACTIVO • XUI BLOQUEADO" android:textColor="#FFFFFF" android:textSize="15sp"/>
<TextView android:id="@+id/paymentBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="22dp" android:padding="18dp" android:background="#10241E" android:textColor="#FFFFFF" android:textSize="18sp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginTop="10dp">
<Button android:id="@+id/processButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="PROCESAR"/>
<Button android:id="@+id/ignoreButton" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="IGNORAR"/>
</LinearLayout>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="PRUEBA MANUAL DE SMS" android:textStyle="bold" android:textColor="#52F2B2" android:textSize="18sp"/>
<EditText android:id="@+id/testInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:minHeight="100dp" android:gravity="top" android:padding="12dp" android:textColor="#FFFFFF" android:textColorHint="#9FB0AA" android:hint="Pega aquí un SMS de BofA" android:backgroundTint="#52F2B2"/>
<Button android:id="@+id/testButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="DETECTAR PAGO DE PRUEBA"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="HISTORIAL" android:textStyle="bold" android:textColor="#52F2B2" android:textSize="18sp"/>
<TextView android:id="@+id/historyBox" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:padding="16dp" android:background="#10241E" android:textColor="#FFFFFF" android:textSize="16sp"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:text="$12 = 1 mes   •   $35 = 3 meses&#10;$66 = 6 meses   •   $125 = 12 meses" android:textColor="#D8E6E1" android:textSize="16sp"/>
</LinearLayout></ScrollView>